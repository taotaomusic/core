{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaotaoMusic",
  "version": "0.1.0",
  "identifier": "com.taotao.music.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "桃桃音乐",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://music.xydaigua.cn/api/v1/desktop/updater/latest.json",
        "https://github.com/taotaomusic/core/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBN0VCODk1QUZENDkwODkKUldTSmtOU3ZsYmgrT2x3N1UzL0V6N3ZKZnI5bVdUUFR2a202QWZkVjB1NGlpbWNxQjlZRVluRDIK"
    }
  }
}
