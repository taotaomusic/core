<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新需要唤起系统安装器。注意：声明此权限的应用不符合 Google Play 上架政策，
         当前为自签名分发，若将来要上架必须改为商店内更新。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 9 及以下保存 AI 图片到公共图库需要运行时授权；Android 10 起走 MediaStore 无需该权限。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- SharedViewKit（金标联盟一镜到底）的 aar 声明 minSdk 26，而本应用是 24。
         API 24/25 设备上 Kit 的类不会被执行（所有调用点都有 SDK_INT >= 26 守卫），
         这里显式压过库的声明以通过 manifest merger。 -->
    <uses-sdk tools:overrideLibrary="com.itgsa.animation.sharedview" />
    <application android:name=".TaotaoApplication" android:theme="@style/Theme.Taotao" android:label="桃桃音乐" android:icon="@drawable/app_icon" android:roundIcon="@drawable/app_icon">
        <!-- configChanges：MV 播放页全屏要在竖横屏间切换，声明后由页面自行处理，
             避免 Activity 重建打断播放（ExoPlayer 与页面状态全部保留）。 -->
        <!-- singleTask：浏览器唤起 taotaomusic://open 时复用既有实例（onNewIntent 送达），
             否则会另起一个携带全新应用状态的副本。 -->
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:launchMode="singleTask" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- 应用内 Deep Link：taotaomusic://open 可唤起桃桃音乐。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taotaomusic" android:host="open" />
            </intent-filter>
        </activity>
        <!-- 播放详情页：从主界面拆出的独立 Activity，承载金标 SharedViewKit 的
             一镜到底转场（ROM 支持时系统接管开合动画）。不设 singleTask ——
             它永远只被主界面（或它自己经深链逻辑）启动，跟随标准任务栈即可。 -->
        <activity
            android:name=".ui.player.PlayerDetailActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Taotao.PlayerDetail" />
        <service android:name=".player.PlaybackService" android:exported="true" android:stopWithTask="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <!-- Android 7 起不允许把 file:// 交给别的应用，安装包必须经 FileProvider 换成 content://。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
