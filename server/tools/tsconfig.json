{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        // NodeNext：node10 解析已弃用（TS 7 移除）；这些脚本按 CommonJS 运行，行为不变。
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./send-outlook-mail.ts", "./verify-totp.ts", "./verify-kpk.ts"]
}
