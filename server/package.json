{
  "name": "taotao-music-proxy",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "dev:frontend": "vite",
    "build": "rimraf --glob dist/* && tsc -p tsconfig.json && npm run minify:server && node tools/copy-manifest.mjs && npm run build:frontend && npm run build:web-player",
    "build:frontend": "vite build",
    "build:web-player": "node tools/build-web-player.mjs",
    "minify:server": "node tools/minify-server.mjs",
    "start": "node dist/main.js",
    "send-mail": "ts-node --project tools/tsconfig.json tools/send-outlook-mail.ts",
    "verify": "node tools/verify-contract.mjs",
    "verify:totp": "ts-node --project tools/tsconfig.json tools/verify-totp.ts",
    "verify:kpk": "ts-node --project tools/tsconfig.json tools/verify-kpk.ts",
    "verify:lrcx": "ts-node --project tools/tsconfig.json tools/verify-lrcx.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "^2.4.0",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/nodemailer": "^8.0.1",
    "@vueuse/core": "^14.4.0",
    "bsdiff-wasm": "^0.1.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "element-plus": "^2.14.5",
    "rimraf": "^6.0.1",
    "terser": "^5.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.7",
    "vue": "^3.5.41"
  }
}
