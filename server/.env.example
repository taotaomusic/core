# 桃桃音乐后端环境变量样例。复制为 .env 后按需修改，.env 不要提交到版本库。

# 监听端口
PORT=4500

# 可选：指定额外的 dotenv 文件路径；系统环境变量优先于该文件
# ENV_FILE=.env

# PostgreSQL 连接串。没有默认值，缺失或格式不对会直接启动失败。
# 需要先建好库：psql -U postgres -c "CREATE DATABASE music"
# 建表由服务启动时自动完成（幂等 DDL），不需要手工执行。
DATABASE_URL=postgres://postgres:密码@localhost:5432/music

# 访问令牌签名密钥。生产环境必须改成随机值，且至少 32 个字符
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# 发布管理令牌。客户端不需要，调用 /api/v1/app/admin/* 或 /api/v1/desktop/admin/* 时通过请求头
# X-Admin-Token 携带。留空则整组管理接口关闭
ADMIN_TOKEN=

# APK 存放目录，发布时写入、客户端下载时读取
APK_DIR=./data/apk
SHARE_PREVIEW_DIR=./data/share-preview
# ffmpeg 不在 PATH 时填写绝对路径；用于生成最多 60 秒、64 kbps 的公开试听文件。
FFMPEG_BIN=ffmpeg

# Windows 模块化发布文件与二进制差分的存放目录
DESKTOP_RELEASE_DIR=./data/desktop
# 可选：Courgette 可执行文件路径，只处理 .dll/.exe；未配置时统一使用 bsdiff
COURGETTE_PATH=
# 当前桌面差分实现使用 bsdiff-wasm；此字段仅兼容旧配置，不是必需项。
# BSDIFF_BIN=bsdiff

# 客户端默认渠道
DEFAULT_CHANNEL=release

# 对外可访问的基地址，用于拼装 APK 下载地址。
# 留空时按请求头推导，但反向代理未透传 X-Forwarded-Proto 时可能推出错误的协议，
# 生产环境建议显式配置
PUBLIC_BASE_URL=https://music.xydaigua.cn

# 搜索并发配置字段保留用于兼容历史部署；当前搜索不解析播放地址，不读取该字段。
# SEARCH_CONCURRENCY=8

# ApiSweet gpt-image-2 图片生成服务。API Key 存在数据库 api_key 表中。
APISWEET_BASE_URL=https://apisweet.com

# 兰空图床头像上传。Key 只配置在服务端，禁止写入 APK 或提交到仓库。
LSKY_UPLOAD_URL=https://img.kiwiyyds.cn/api/index.php
LSKY_API_KEY=

# 注册邮箱验证码。必须配置完整 SMTP 才能发码；缺失时服务会拒绝注册验证码请求，
# 绝不会降级为无邮箱验证的注册。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=请填写应用专用密码
SMTP_FROM=桃桃音乐 <no-reply@example.com>

# 悟空 IM。产品 API 只能监听在本机回环地址；5100 已确认是 WKProto 原生 TCP Gateway，
# 不能填写 http://。客户端使用 tcp:// 地址，管理 API 由本服务通过 127.0.0.1:5001 调用。
IM_ENABLED=false
IM_INTERNAL_API_BASE_URL=http://127.0.0.1:5001
IM_EXTERNAL_GATEWAY_URL=tcp://im.xydaigua.cn:5100
# 若悟空 IM 为产品 API 启用了服务端令牌，在这里配置；不要下发到客户端。
IM_API_TOKEN=
# Android 在过期前应续签；Gateway 还必须启用服务端 Token 校验。
IM_SESSION_LIFETIME_SECONDS=900

# 仅契约验证进程可用，必须同时设置 NODE_ENV=test；生产环境不要填写。
# EMAIL_VERIFICATION_TEST_CODE=123456
