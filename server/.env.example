# 桃桃音乐后端环境变量样例。复制为 .env 后按需修改，.env 不要提交到版本库。

# 监听端口
PORT=4500

# SQLite 数据库路径
DATABASE_PATH=./data/music.sqlite

# 访问令牌签名密钥。生产环境必须改成随机值，且至少 32 个字符
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# 发布管理令牌。客户端不需要，只在调用 /api/v1/app/admin/* 时通过请求头
# X-Admin-Token 携带。留空则整组管理接口关闭
ADMIN_TOKEN=

# APK 存放目录，发布时写入、客户端下载时读取
APK_DIR=./data/apk

# 客户端默认渠道
DEFAULT_CHANNEL=release

# 对外可访问的基地址，用于拼装 APK 下载地址。
# 留空时按请求头推导，但反向代理未透传 X-Forwarded-Proto 时可能推出错误的协议，
# 生产环境建议显式配置
PUBLIC_BASE_URL=https://music.xydaigua.cn
