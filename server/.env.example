# 桃桃音乐后端环境变量样例。复制为 .env 后按需修改，.env 不要提交到版本库。

# 运行环境：development / production / test。
# production 目前只是语义标记，服务端没有基于它的额外强制校验；
# test 仅供契约验证进程使用。不设置时按开发环境处理。
# 注意：AUTH_SECRET 的强度校验不受这个变量影响，任何环境都要求至少 32 个字符。
NODE_ENV=development

# 监听端口
PORT=4500

# 可选：指定额外的 dotenv 文件路径；系统环境变量优先于该文件
# ENV_FILE=.env

# PostgreSQL 连接串。没有默认值，缺失或格式不对会直接启动失败。
# 需要先建好库：psql -U postgres -c "CREATE DATABASE music"
# 建表由服务启动时自动完成（幂等 DDL），不需要手工执行。
DATABASE_URL=postgres://postgres:密码@localhost:5432/music

# 访问令牌签名密钥。**必须至少 32 个字符，缺失或过短会直接启动失败**，没有开发兜底值。
# 生产环境请用随机值，例如：openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# 传输加密 PSK（可选，与客户端加密链路配套）。CRYPTO_PSK_ID 是 PSK 标识，
# CRYPTO_PSK_HEX 是 32 字节的 hex 原始密钥（64 个十六进制字符），两项需同时配置。
# 未配置或加密产物缺失时握手全部失败，链路保持明文，不影响其它功能。
# CRYPTO_PSK_ID=
# CRYPTO_PSK_HEX=

# 默认超级管理员的初始口令（可选）。留空时启动阶段随机生成一个，只在日志里打印一次。
# 无论哪种来源，该账号首次登录都必须改密（must_change_password），改密前除
# /admin/auth/me 与 /admin/auth/change-password 外一律 403/4031。
# 设置时至少 12 个字符，否则启动失败。**不要在生产环境保留样例值。**
ADMIN_INITIAL_PASSWORD=

# APK 存放目录，发布时写入、客户端下载时读取
APK_DIR=./data/apk

# Windows 模块化发布文件与二进制差分的存放目录
DESKTOP_RELEASE_DIR=./data/desktop
# 可选：Courgette 可执行文件路径，只处理 .dll/.exe；未配置时统一使用 bsdiff
COURGETTE_PATH=
# 当前桌面差分实现使用 bsdiff-wasm；此字段仅兼容旧配置，不是必需项。
# BSDIFF_BIN=bsdiff

# 客户端默认渠道
DEFAULT_CHANNEL=release

# 对外可访问的基地址，用于拼装 APK 下载地址。
# 留空时按请求头推导，但反向代理未透传 X-Forwarded-Proto 时可能推出错误的协议，
# 生产环境建议显式配置
PUBLIC_BASE_URL=https://music.xydaigua.cn

# 搜索并发配置字段保留用于兼容历史部署；当前搜索不解析播放地址，不读取该字段。
# SEARCH_CONCURRENCY=8

# ApiSweet gpt-image-2 图片生成服务。API Key 存在数据库 api_key 表中。
APISWEET_BASE_URL=https://apisweet.com

# 兰空图床头像上传。Key 只配置在服务端，禁止写入 APK 或提交到仓库。
LSKY_UPLOAD_URL=https://img.kiwiyyds.cn/api/index.php
LSKY_API_KEY=
# 可选：允许写入用户头像地址的图床主机白名单（逗号分隔，大小写不敏感）。
# 头像地址由图床响应决定、会被其它客户端请求，配了白名单才能防止图床被劫持或
# 配置写错时把任意域名写进用户资料。留空表示只要求「https 且格式合法」。
# LSKY_PUBLIC_HOSTS=img.kiwiyyds.cn

# 可选：允许跨域读取接口响应的来源白名单（逗号分隔，形如 https://a.example）。
# **默认留空即不下发任何 CORS 头**：管理后台与分享页都由本服务同源托管，
# 不需要 CORS；通配 * 会让任意站点在用户浏览器里读取公开接口响应。
# 音视频流与搜索接口不受此白名单约束，它们有自己的路由级 *。
# CORS_ALLOWED_ORIGINS=https://music.xydaigua.cn

# 注册邮箱验证码。必须配置完整 SMTP 才能发码；缺失时服务会拒绝注册验证码请求，
# 绝不会降级为无邮箱验证的注册。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=请填写应用专用密码
SMTP_FROM=桃桃音乐 <no-reply@example.com>

# 悟空 IM。产品 API 只能监听在本机回环地址；5100 已确认是 WKProto 原生 TCP Gateway，
# 不能填写 http://。客户端使用 tcp:// 地址，管理 API 由本服务通过 127.0.0.1:5001 调用。
IM_ENABLED=false
IM_INTERNAL_API_BASE_URL=http://127.0.0.1:5001
IM_EXTERNAL_GATEWAY_URL=tcp://im.xydaigua.cn:5100
# 若悟空 IM 为产品 API 启用了服务端令牌，在这里配置；不要下发到客户端。
IM_API_TOKEN=
# Android 在过期前应续签；Gateway 还必须启用服务端 Token 校验。
IM_SESSION_LIFETIME_SECONDS=900

# 管理后台认证
TOTP_ISSUER=桃桃音乐管理后台

# LDAP/SSO（可选，不配置则使用本地管理员账号）
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
# LDAP_USER_SEARCH_FILTER=(uid={{username}})
# LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
# LDAP_GROUP_SEARCH_FILTER=(member={{userDn}})
# LDAP_ROLE_MAPPING={"cn=admins,ou=groups,dc=example,dc=com":"super_admin","cn=operators,ou=groups,dc=example,dc=com":"admin"}
# LDAPS 是否校验证书，默认 true。内网自签证书才设为 false；
# 服务端目前不按 NODE_ENV 强制约束本变量（生产硬约束是历史设想，未实现）。
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_TIMEOUT_MS=10000

# 是否采信 X-Forwarded-For 作为客户端地址，默认关闭。
# 只有确实部署在可信反向代理之后才设为 1；否则 IP 白名单可被伪造请求头绕过。
# TRUST_PROXY=1

# 仅契约验证进程可用，必须同时设置 NODE_ENV=test；生产环境不要填写。
# EMAIL_VERIFICATION_TEST_CODE=123456
