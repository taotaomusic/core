# 复制为 .env 后填写。docker compose 会自动读取同目录的 .env。
# ⚠️ .env 含密钥，不要提交到仓库（已在 .gitignore 忽略 .env）。

# --- 数据库 ---
POSTGRES_USER=taotao
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=music

# --- 应用 ---
# 至少 32 字符：openssl rand -hex 32
AUTH_SECRET=换成至少32字符的随机串
# 至少 12 位，首次登录强制改密
ADMIN_INITIAL_PASSWORD=换成初始管理员密码
# 允许的前端来源，逗号分隔；没有可留空
CORS_ALLOWED_ORIGINS=https://你的域名
# 宿主机暴露端口（容器内固定 4720）
APP_PORT=4720

# --- 传输加密 ---
# 固定 PSK（生产必须固定，否则重启即变）。生成：openssl rand -hex 32
CRYPTO_PSK_ID=prod-v1
CRYPTO_PSK_HEX=换成64位十六进制
